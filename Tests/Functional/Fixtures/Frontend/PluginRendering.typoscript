page = PAGE
page.10 < styles.content.get

plugin.tx_thuecat {
    view {
        templateRootPaths.10 = EXT:thuecat/Resources/Private/Templates/
        partialRootPaths.10 = EXT:thuecat/Resources/Private/Partials/
    }
    settings {
        page.pid.thuecat_attraction_search = 10
    }
}

tt_content.werkraummedia_thuecatattractionlist = EXTBASEPLUGIN
tt_content.werkraummedia_thuecatattractionlist {
    extensionName = ThueCat
    pluginName = TouristAttractionList
}

tt_content.werkraummedia_thuecatattractionsearch = EXTBASEPLUGIN
tt_content.werkraummedia_thuecatattractionsearch {
    extensionName = ThueCat
    pluginName = TouristAttractionSearch
}

tt_content.werkraummedia_thuecatattractionlistselected = EXTBASEPLUGIN
tt_content.werkraummedia_thuecatattractionlistselected {
    extensionName = ThueCat
    pluginName = TouristAttractionListSelected
}

tt_content.werkraummedia_thuecatattractionshow = EXTBASEPLUGIN
tt_content.werkraummedia_thuecatattractionshow {
    extensionName = ThueCat
    pluginName = TouristAttractionShow
}

tt_content.werkraummedia_thuecattraillistselected = EXTBASEPLUGIN
tt_content.werkraummedia_thuecattraillistselected {
    extensionName = ThueCat
    pluginName = TrailListSelected
}

tt_content.werkraummedia_thuecattrailshow = EXTBASEPLUGIN
tt_content.werkraummedia_thuecattrailshow {
    extensionName = ThueCat
    pluginName = TrailShow
}