page = PAGE
page.10 < styles.content.get

# FLUIDTEMPLATE inlined instead of lib.contentElement, which only EXT:fluid_styled_content defines.
tt_content.thuecat_tourist_attraction = FLUIDTEMPLATE
tt_content.thuecat_tourist_attraction {
    templateName = TouristAttraction
    templateRootPaths {
        10 = EXT:example/Resources/Private/Templates/ContentElement/
    }
    partialRootPaths {
        10 = EXT:example/Resources/Private/Partials/ContentElement/
    }

}