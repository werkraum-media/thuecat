includes:
  - 'phpstan-baseline.neon'
parameters:
  level: 'max'
  # Core types differ between v13 and v14; a guard one version needs is
  # "already narrowed" on the other.
  treatPhpDocTypesAsCertain: false
  paths:
    - 'Classes'
    - 'Configuration'
    - 'Tests'
  reportUnmatchedIgnoredErrors: true
  ignoreErrors:
    - identifier: 'missingType.generics'
    - identifier: 'missingType.iterableValue'
    # Version-dependent errors live here rather than in the baseline:
    -
      message: '#^Method WerkraumMedia\\ThueCat\\Tests\\Functional\\Typo3\\Hook\\AddTitleForStaticUrlsDataHandlerHookTest\:\:executeDataHandler\(\) should return array\<string\> but returns array\.$#'
      identifier: return.type
      path: 'Tests/Functional/Typo3/Hook/AddTitleForStaticUrlsDataHandlerHookTest.php'
      reportUnmatched: false
