includes:
  - 'phpstan-baseline.neon'
parameters:
  level: 'max'
  paths:
    - 'Build'
    - 'Classes'
    - 'Configuration'
    - 'Tests'
  reportUnmatchedIgnoredErrors: true
  typo3:
    requestGetAttributeMapping:
      pageContext: TYPO3\CMS\Backend\Context\PageContext
  ignoreErrors:
    - identifier: 'missingType.generics'
    - identifier: 'missingType.iterableValue'
    # Guzzle's config shape is version-dependent; ours comes from
    # TYPO3_CONF_VARS['HTTP'], so it stays array<string, mixed> by nature.
    -
      identifier: argument.type
      path: 'Classes/Import/Http/ImportClientFactory.php'
      reportUnmatched: false
