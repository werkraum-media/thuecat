includes:
  - 'phpstan-baseline.neon'
parameters:
  level: 'max'
  # Core types differ between v13 and v14; a guard one version needs is
  # "already narrowed" on the other.
  treatPhpDocTypesAsCertain: false
  paths:
    - 'Classes'
    - 'Configuration'
    - 'Tests'
  reportUnmatchedIgnoredErrors: true
  ignoreErrors:
    - identifier: 'missingType.generics'
    - identifier: 'missingType.iterableValue'
    # Version-dependent errors live here rather than in the baseline:
    -
      message: '#^Method WerkraumMedia\\ThueCat\\Tests\\Functional\\Typo3\\Hook\\AddTitleForStaticUrlsDataHandlerHookTest\:\:executeDataHandler\(\) should return array\<string\> but returns array\.$#'
      identifier: return.type
      path: 'Tests/Functional/Typo3/Hook/AddTitleForStaticUrlsDataHandlerHookTest.php'
      reportUnmatched: false
    # Guzzle's config shape is version-dependent; ours comes from
    # TYPO3_CONF_VARS['HTTP'], so it stays array<string, mixed> by nature.
    -
      identifier: argument.type
      path: 'Classes/Import/Http/ImportClientFactory.php'
      reportUnmatched: false
    # FlexFormTools::parseDataStructureByIdentifier() only gained its $schema
    # parameter in v14; passing it under v13 is a harmless extra argument.
    -
      message: '#^Method TYPO3\\CMS\\Core\\Configuration\\FlexForm\\FlexFormTools\:\:parseDataStructureByIdentifier\(\) invoked with 2 parameters, 1 required\.$#'
      identifier: arguments.count
      path: 'Classes/Typo3/EventListener/SiteScopedRelationsPageTsConfigListener.php'
      reportUnmatched: false
