    <file source-language="en" datatype="plaintext" original="messages" date="2026-11-19T00:00:00Z" product-name="thuecat">
        <header/>
        <body>
            <trans-unit id="mlang_tabs_tab" resname="mlang_tabs_tab">
                <source>Remove imported data</source>
            </trans-unit>
            <trans-unit id="mlang_labels_tablabel" resname="mlang_labels_tablabel">
                <source>Removes imported POIs, places, trails and events with what only they use</source>
            </trans-unit>
            <trans-unit id="mlang_labels_tabdescr" resname="mlang_labels_tabdescr">
                <source>Removes the imported roots of one kind from a folder, a site or the instance, or reverts one import within a site. Relations and files nothing else uses go with them.</source>
            </trans-unit>
            <trans-unit id="headline" resname="headline">
                <source>Remove imported data</source>
            </trans-unit>
            <trans-unit id="empty.title" resname="empty.title">
                <source>Nothing to remove</source>
            </trans-unit>
            <trans-unit id="empty.text" resname="empty.text">
                <source>No page holds POIs, places, trails or events.</source>
            </trans-unit>
            <trans-unit id="site.outside" resname="site.outside">
                <source>Pages outside any site</source>
            </trans-unit>
            <trans-unit id="page" resname="page">
                <source>Page</source>
            </trans-unit>
            <trans-unit id="origins" resname="origins">
                <source>Imports the roots of this site originate from</source>
            </trans-unit>
            <trans-unit id="origin" resname="origin">
                <source>Import configuration</source>
            </trans-unit>
            <trans-unit id="origin.roots" resname="origin.roots">
                <source>Roots</source>
            </trans-unit>
            <trans-unit id="action.instance" resname="action.instance">
                <source>Remove all %s of the instance</source>
            </trans-unit>
            <trans-unit id="action.site" resname="action.site">
                <source>Remove from site</source>
            </trans-unit>
            <trans-unit id="action.folder" resname="action.folder">
                <source>Remove from this folder</source>
            </trans-unit>
            <trans-unit id="action.origin" resname="action.origin">
                <source>Revert this import</source>
            </trans-unit>
            <trans-unit id="confirm.headline" resname="confirm.headline">
                <source>Confirm removal</source>
            </trans-unit>
            <trans-unit id="confirm.scope.folder" resname="confirm.scope.folder">
                <source>%1$s of folder %2$s [%3$d]</source>
            </trans-unit>
            <trans-unit id="confirm.scope.site" resname="confirm.scope.site">
                <source>%1$s of site %2$s</source>
            </trans-unit>
            <trans-unit id="confirm.scope.instance" resname="confirm.scope.instance">
                <source>%s of the whole instance</source>
            </trans-unit>
            <trans-unit id="confirm.scope.origin" resname="confirm.scope.origin">
                <source>Every POI, place, trail and event of import %1$s [%2$d] in site %3$s</source>
            </trans-unit>
            <trans-unit id="confirm.roots" resname="confirm.roots">
                <source>This removes %d roots</source>
            </trans-unit>
            <trans-unit id="confirm.roots.text" resname="confirm.roots.text">
                <source>Translations, inline children and file references go with each root, and relations nothing else uses are removed too. This cannot be undone.</source>
            </trans-unit>
            <trans-unit id="confirm.removeFiles" resname="confirm.removeFiles">
                <source>Also delete files nothing uses any longer</source>
            </trans-unit>
            <trans-unit id="confirm.updateReferenceIndex" resname="confirm.updateReferenceIndex">
                <source>Update the reference index first</source>
            </trans-unit>
            <trans-unit id="confirm.start" resname="confirm.start">
                <source>Queue removal</source>
            </trans-unit>
            <trans-unit id="confirm.cancel" resname="confirm.cancel">
                <source>Cancel</source>
            </trans-unit>
            <trans-unit id="queued.title" resname="queued.title">
                <source>Removal queued</source>
            </trans-unit>
            <trans-unit id="queued.text" resname="queued.text">
                <source>The removal runs in the background, one root after the other.</source>
            </trans-unit>
            <trans-unit id="jobs.finished" resname="jobs.finished">
                <source>Finished removal jobs</source>
            </trans-unit>
            <trans-unit id="jobs.finished.empty" resname="jobs.finished.empty">
                <source>No removal job has finished yet.</source>
            </trans-unit>
            <trans-unit id="jobs.open" resname="jobs.open">
                <source>Queued and running removal jobs</source>
            </trans-unit>
            <trans-unit id="jobs.open.empty" resname="jobs.open.empty">
                <source>No removal job is queued or running.</source>
            </trans-unit>
            <trans-unit id="job.selection" resname="job.selection">
                <source>Selection</source>
            </trans-unit>
            <trans-unit id="job.scope.origin" resname="job.scope.origin">
                <source>Every POI, place, trail and event of import [%1$d] in site %2$s</source>
            </trans-unit>
            <trans-unit id="job.status" resname="job.status">
                <source>Status</source>
            </trans-unit>
            <trans-unit id="job.status.queued" resname="job.status.queued">
                <source>queued</source>
            </trans-unit>
            <trans-unit id="job.status.running" resname="job.status.running">
                <source>running</source>
            </trans-unit>
            <trans-unit id="job.status.done" resname="job.status.done">
                <source>done</source>
            </trans-unit>
            <trans-unit id="job.user" resname="job.user">
                <source>Started by</source>
            </trans-unit>
            <trans-unit id="job.removedRoots" resname="job.removedRoots">
                <source>Removed roots</source>
            </trans-unit>
            <trans-unit id="job.skippedRoots" resname="job.skippedRoots">
                <source>Skipped roots</source>
            </trans-unit>
            <trans-unit id="job.removedRelations" resname="job.removedRelations">
                <source>Removed relations</source>
            </trans-unit>
            <trans-unit id="job.removedFiles" resname="job.removedFiles">
                <source>Removed files</source>
            </trans-unit>
            <trans-unit id="job.errors" resname="job.errors">
                <source>Errors</source>
            </trans-unit>
            <trans-unit id="job.errorLog" resname="job.errorLog">
                <source>Error log</source>
            </trans-unit>
            <trans-unit id="job.status.stalled" resname="job.status.stalled">
                <source>stalled</source>
            </trans-unit>
            <trans-unit id="stalled.title" resname="stalled.title">
                <source>%d removal jobs are not taken further</source>
            </trans-unit>
            <trans-unit id="stalled.text" resname="stalled.text">
                <source>Each of them has been queued, or running without progress, for more than five minutes. Removal jobs do not run in the backend: a scheduler task of type "messenger:consume" with the receiver "doctrine" runs every minute and works through the queue one root after the other. While that task does not run, no job moves, and nothing has been removed yet for a queued job.</source>
            </trans-unit>
            <trans-unit id="stalled.causes" resname="stalled.causes">
                <source>Usual causes: the task was never created on this instance, it is disabled, cron does not start the scheduler, or a killed run of the task is still marked as running in the scheduler module, which blocks every later run until it is stopped there.</source>
            </trans-unit>
            <trans-unit id="stalled.link" resname="stalled.link">
                <source>How to set up the message worker task</source>
            </trans-unit>
            <trans-unit id="cleanup.title" resname="cleanup.title">
                <source>Old removal jobs are kept</source>
            </trans-unit>
            <trans-unit id="cleanup.text" resname="cleanup.text">
                <source>The oldest finished job is more than ten days old. Finished jobs stay in the database until a table garbage collection task of the scheduler removes them, together with old import logs and soft-deleted records.</source>
            </trans-unit>
            <trans-unit id="cleanup.link" resname="cleanup.link">
                <source>Recommended cleanup tasks</source>
            </trans-unit>
        </body>
    </file>
